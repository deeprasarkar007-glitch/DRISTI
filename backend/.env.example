# Copy this file to ".env" and adjust if needed.

# Origin(s) allowed to call this API (your Next.js dev server).
FRONTEND_ORIGIN=http://localhost:3000

# Where the trained model lives. Defaults to backend/saved_model if not set.
# MODEL_DIR=C:\path\to\dumper-truck-detector\backend\saved_model

# Applies a CLAHE-based contrast boost to every frame before it's classified,
# to help with fog/haze. On by default. Set to "false" to disable (e.g. to
# compare behaviour with/without it).
# ENHANCE_VISIBILITY=true

# Only used in similarity mode (see README). Overrides the threshold computed
# by the training notebook (saved_model/threshold.json) without needing to
# retrain — raise it if it's firing on things that aren't your dumper truck,
# lower it if it's missing the real thing. Check GET /health to see the
# threshold currently in effect, and the "raw_score" field returned by
# /predict on live frames to see where your scores actually land.
# SIMILARITY_THRESHOLD=0.65
